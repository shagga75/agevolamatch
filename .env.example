# Copy to .env and fill in the values you need. Never commit the real .env.

# Where the API and alerts CLI read/write the SQLite database.
AGEVOLAMATCH_DB_PATH=data/agevolamatch.db

# --- Email channel (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true

# --- Telegram channel ---
# Create a bot via https://t.me/BotFather to get a token, then message the
# bot once and check https://api.telegram.org/bot<TOKEN>/getUpdates to find
# your chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional LLM (used only with `match --llm`; everything works without it) ---
# Leave empty to keep the LLM feature fully disabled. Set to "ollama" or "openai".
AGEVOLAMATCH_LLM_PROVIDER=

# ollama provider (local, free, no API key)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
# A 3B+ model on CPU-only hardware can take well over 60s to cold-load and
# respond - raise this if you see timeouts in the logs.
OLLAMA_TIMEOUT_SECONDS=120

# openai provider (paid API, or any OpenAI-compatible endpoint)
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
