# Copy to .env and fill in the values you need. Never commit the real .env.

# Where the API and alerts CLI read/write the SQLite database.
AGEVOLAMATCH_DB_PATH=data/agevolamatch.db

# --- Email channel (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true

# --- Telegram channel ---
# Create a bot via https://t.me/BotFather to get a token, then message the
# bot once and check https://api.telegram.org/bot<TOKEN>/getUpdates to find
# your chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
